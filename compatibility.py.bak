import json
from pathlib import Path

from atom import parse_atom
from versions import compare_versions, arch_to_upstream

BASE = Path(__file__).parent


def load_mappings():
    with (BASE / "config/mappings.json").open() as f:
        return json.load(f)


def version_matches(installed, required, operator, wildcard=False):
    if required is None:
        return None

    candidate = arch_to_upstream(installed)

    if candidate is None:
        return None

    if wildcard:
        return candidate.startswith(required)

    try:
        comparison = compare_versions(candidate, required)
    except ValueError:
        return None

    if operator == ">=":
        return comparison >= 0
    if operator == "<=":
        return comparison <= 0
    if operator == ">":
        return comparison > 0
    if operator == "<":
        return comparison < 0
    if operator == "=":
        return comparison == 0
    if operator == "~":
        # Gentoo ~ matches the same version, ignoring revision.
        return compare_versions(
            candidate.rsplit("-r", 1)[0],
            required.rsplit("-r", 1)[0]
        ) == 0

    return True


def resolve(atom_string, installed):
    atom = parse_atom(atom_string)
    mappings = load_mappings()

    gentoo_name = f"{atom.category}/{atom.package}"

    arch_name = next(
        (
            name for name, target in mappings.items()
            if target == gentoo_name
        ),
        None
    )

    if arch_name is None or arch_name not in installed:
        return None

    arch_version = installed[arch_name]

    version_result = version_matches(
        arch_version,
        atom.version,
        atom.operator,
        atom.wildcard
    )

    if version_result is False:
        status = "VERSION_MISMATCH"
    elif version_result is True:
        status = "VERSION_MATCH"
    else:
        status = "UNVERIFIED"

    return {
        "arch": arch_name,
        "version": arch_version,
        "gentoo": gentoo_name,
        "required_version": atom.version,
        "operator": atom.operator,
        "slot": atom.slot,
        "version_compatible": version_result,
        "status": status,
        "reason": (
            "Version constraint satisfied; ABI and slot compatibility "
            "still require verification."
            if version_result is True
            else "Version compatibility could not be established."
            if version_result is None
            else "Installed version does not satisfy the Gentoo constraint."
        )
    }
